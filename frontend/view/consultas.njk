{% extends "layout.njk" %}

{% block content %}
<div class="page-heading">
    <h3>Consultas</h3>
    <p class="text-subtitle text-muted">
        Agendamentos e atendimentos do hospital.
    </p>
</div>

<a href="/consultas/novo" class="btn btn-primary mb-4">
    <i class="bi bi-plus-circle"></i> Nova consulta
</a>

<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6>Consultas ativas</h6>
                <h2 id="totalConsultas">0</h2>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h4>Consultas cadastradas</h4>
        
        <label for="buscaConsulta" class="form-label">Pesquisar</label>
        <input id="buscaConsulta" type="search" class="form-control mb-3" placeholder="Paciente ou médico">
        
        <div id="mensagemConsultas" class="alert alert-danger d-none"></div>
        
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Paciente</th>
                        <th>Médico</th>
                        <th>Data</th>
                        <th>Valor</th>
                        <th>Realizada</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody id="corpoConsultas"></tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/apps/consultas/vwConsultas.js"></script>
{% endblock %}
