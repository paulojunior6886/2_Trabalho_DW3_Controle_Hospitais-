
{% extends "layout.njk" %}

{% block content %}

<div class="page-heading">
    <h3>Médicos</h3>

    <p class="text-subtitle text-muted">
        Cadastro de médicos do hospital.
    </p>
</div>

<a href="/medicos/novo" class="btn btn-primary mb-4">
    <i class="bi bi-plus-circle"></i>
    Novo médico
</a>

<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">

                <h6>Profissionais ativos</h6>

                <h2 id="totalMedicos">0</h2>

            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">

        <h4>Médicos cadastrados</h4>

        <label class="form-label" for="buscaMedico">
            Pesquisar
        </label>

        <input
            id="buscaMedico"
            type="search"
            class="form-control mb-3"
            placeholder="Nome, CRM ou especialidade">

        <div id="mensagemMedicos"
             class="alert alert-danger d-none">
        </div>

        <div class="table-responsive">
            <table class="table table-hover">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>CRM</th>
                        <th>Especialidade</th>
                        <th>Ações</th>
                    </tr>
                </thead>

                <tbody id="corpoMedicos"></tbody>

            </table>
        </div>

    </div>
</div>

{% endblock %}

{% block scripts %}
<script src="/apps/medicos/vwMedicos.js"></script>
{% endblock %}
