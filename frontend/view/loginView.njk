
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <title>Entrar - MedControl</title>

    <link rel="stylesheet"
          href="/assets/compiled/css/app.css">

    <link rel="stylesheet"
          href="/assets/compiled/css/app-dark.css">

    <link rel="stylesheet"
          href="/css/hospital.css">
</head>

<body data-api="{{ backendUrl }}">

<script src="/assets/static/js/initTheme.js"></script>

<div class="container">
    <div class="row justify-content-center align-items-center min-vh-100">

        <div class="col-md-7 col-lg-5">
            <div class="card shadow-sm">

                <div class="card-body p-5">

                    <h2 class="text-center mb-2">
                        MedControl
                    </h2>

                    <p class="text-center text-muted mb-4">
                        Acesso ao módulo hospitalar
                    </p>

                    <div id="mensagemLogin"
                         class="alert alert-danger d-none">
                    </div>

                    <form id="formLogin"
                          data-backend-url="{{ backendUrl }}">

                        <div class="form-group mb-3">
                            <label for="username" class="form-label">
                                Usuário
                            </label>

                            <input
                                id="username"
                                type="text"
                                class="form-control"
                                autocomplete="username"
                                required>
                        </div>

                        <div class="form-group mb-4">
                            <label for="password" class="form-label">
                                Senha
                            </label>

                            <input
                                id="password"
                                type="password"
                                class="form-control"
                                autocomplete="current-password"
                                required>
                        </div>

                        <button type="submit"
                                id="btnEntrar"
                                class="btn btn-primary w-100">
                            Entrar
                        </button>

                    </form>

                </div>
            </div>
        </div>

    </div>
</div>

<script src="/js/auth.js"></script>
<script src="/apps/login/vwLogin.js"></script>

</body>
</html>
