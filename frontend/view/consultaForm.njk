{% extends "layout.njk" %}

{% block content %}
<div class="page-heading">
    <h3>
        {% if operacao == "novo" %}
            Agendar consulta
        {% elif operacao == "editar" %}
            Editar consulta
        {% else %}
            Visualizar consulta
        {% endif %}
    </h3>
    <p class="text-subtitle text-muted">
        Dados do atendimento.
    </p>
</div>

<div class="card">
    <div class="card-body">
        <div id="mensagemConsulta" class="alert alert-danger d-none"></div>
        
        <form id="formConsulta" data-id="{{ id }}" data-operacao="{{ operacao }}">
            <div class="row g-3">
                <div class="col-md-2">
                    <label for="idConsulta" class="form-label">ID</label>
                    <input id="idConsulta" class="form-control" readonly>
                </div>
                
                <div class="col-md-6">
                    <label for="paciente_nome" class="form-label">Nome do paciente</label>
                    <input id="paciente_nome" class="form-control" maxlength="100" required>
                </div>
                
                <div class="col-md-4">
                    <label for="data_consulta" class="form-label">Data</label>
                    <input id="data_consulta" type="date" class="form-control" required>
                </div>
                
                <div class="col-md-4">
                    <label for="valor" class="form-label">Valor (R$)</label>
                    <input id="valor" type="number" min="0" max="99999999.99" step="0.01" class="form-control" required>
                </div>
                
                <div class="col-md-6">
                    <label for="medico_id" class="form-label">Médico</label>
                    <select id="medico_id" class="form-select" required></select>
                </div>
                
                <div class="col-md-12">
                    <div class="form-check">
                        <input id="realizada" type="checkbox" class="form-check-input">
                        <label for="realizada" class="form-check-label">
                            Consulta realizada
                        </label>
                    </div>
                </div>
            </div>
            
            <div class="mt-4">
                <button id="salvarConsulta" type="submit" class="btn btn-primary">
                    Salvar
                </button>
                <a href="/consultas" class="btn btn-secondary ms-2">
                    Voltar
                </a>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/apps/consultas/vwConsultas.js"></script>
{% endblock %}
